+void scto_sm2encrypt_encode(uint8_t *input, uint32_t inlen, uint8_t *output,
+			    uint32_t *outlen)
+{
+	uint8_t *c2;
+	uint8_t x[32], y[32], hash[32];
+	uint8_t xhead[4], yhead[4], hashhead[4], c2head[8], head[8];
+	uint32_t offset, length, c2headlen, xheadlen, yheadlen, hashheadlen,
+		headlen, c2len, i;
+	uint32_t xlen, ylen;
+
+	c2 = input + 97;
+	memcpy(x, input + 1, 32);
+	memcpy(y, input + 33, 32);
+	memcpy(hash, input + 65, 32);
+
+	c2len = inlen - 97;
+	c2headlen = 2;
+	if (c2len > 127)
+		c2headlen = 3;
+	if (c2len > 255)
+		c2headlen = 4;
+	if (c2len > 65535)
+		c2headlen = 5;
+	if (c2len > 16777215)
+		c2headlen = 6;
+
+	c2head[0] = 0x04; // Tag, ASN1_OTS
+	switch (c2headlen) {
+	case 2:
+		c2head[1] = c2len; //Len(bit7 = 0)
+		break;
+	case 3:
+		c2head[1] = 0x81; //Len(bit7 = 1, bit0-6 = Len length)
+		c2head[2] = c2len;
+		break;
+	case 4:
+		c2head[1] = 0x82;
+		c2head[2] = c2len >> 8;
+		c2head[3] = c2len;
+		break;
+	case 5:
+		c2head[1] = 0x83;
+		c2head[2] = c2len >> 16;
+		c2head[3] = c2len >> 8;
+		c2head[4] = c2len;
+		break;
+	case 6:
+		c2head[1] = 0x84;
+		c2head[2] = c2len >> 24;
+		c2head[3] = c2len >> 16;
+		c2head[4] = c2len >> 8;
+		c2head[5] = c2len;
+		break;
+	default:
+		break;
+	}
+
+	for (i = 0; i < 31; i++) {
+		if (x[i])
+			break;
+	}
+	xlen = 32 - i;
+	xheadlen = 2;
+	if (x[i] & 0x80) //Highest bit, x is unsigned Integer
+		xheadlen = 3;
+	xhead[0] = 0x2; //Tag, ASN1_INT
+	switch (xheadlen) {
+	case 2:
+		xhead[1] = xlen;
+		break;
+	case 3:
+		xhead[1] = xlen + 1;
+		xhead[2] = 0x00;
+		break;
+	default:
+		break;
+	}
+
+	for (i = 0; i < 31; i++) {
+		if (y[i])
+			break;
+	}
+	ylen = 32 - i;
+	yheadlen = 2;
+	if (y[i] & 0x80) //Highest bit, y is unsigned Integer
+		yheadlen = 3;
+	yhead[0] = 0x2; //Tag, ASN1_INT
+	switch (yheadlen) {
+	case 2:
+		yhead[1] = ylen;
+		break;
+	case 3:
+		yhead[1] = ylen + 1;
+		yhead[2] = 0x00;
+		break;
+	default:
+		break;
+	}
+
+	hashheadlen = 2;
+	hashhead[0] = 0x04; // Tag, ASN1_OTS
+	hashhead[1] = 0x20;
+
+	length = c2headlen + c2len;
+	length += xheadlen + xlen;
+	length += yheadlen + ylen;
+	length += hashheadlen + 32;
+
+	headlen = 2;
+	if (length > 127)
+		headlen = 3;
+	if (length > 255)
+		headlen = 4;
+	if (length > 65535)
+		headlen = 5;
+	if (length > 16777215)
+		headlen = 6;
+
+	head[0] = 0x30; //Tag, ASN1_SEQ, Value = TLV + TLV + ...
+	switch (headlen) {
+	case 2:
+		head[1] = length;
+		break;
+	case 3:
+		head[1] = 0x81;
+		head[2] = length;
+		break;
+	case 4:
+		head[1] = 0x82;
+		head[2] = length >> 8;
+		head[3] = length;
+		break;
+	case 5:
+		head[1] = 0x83;
+		head[2] = length >> 16;
+		head[3] = length >> 8;
+		head[4] = length;
+		break;
+	case 6:
+		head[1] = 0x84;
+		head[2] = length >> 24;
+		head[3] = length >> 16;
+		head[4] = length >> 8;
+		head[5] = length;
+		break;
+	default:
+		break;
+	}
+
+	offset = 0;
+	memcpy(output + offset, head, headlen);
+	offset += headlen;
+	memcpy(output + offset, xhead, xheadlen);
+	offset += xheadlen;
+	memcpy(output + offset, x + 32 - xlen, xlen);
+	offset += xlen;
+	memcpy(output + offset, yhead, yheadlen);
+	offset += yheadlen;
+	memcpy(output + offset, y + 32 - ylen, ylen);
+	offset += ylen;
+	memcpy(output + offset, hashhead, hashheadlen);
+	offset += hashheadlen;
+	memcpy(output + offset, hash, 32);
+	offset += 32;
+	memcpy(output + offset, c2head, c2headlen);
+	offset += c2headlen;
+	memmove(output + offset, c2, c2len);
+	offset += c2len;
+
+	*outlen = offset;
+}
+
+int scto_sm2decrypt_decode(uint8_t *input, uint32_t inlen, uint8_t *output,
+			   uint32_t *outlen)
+{
+	uint8_t x[32] = { 0 }, y[32] = { 0 }, hash[32];
+	uint32_t offset, length, c2headlen, xheadlen, yheadlen, hashheadlen,
+		headlen, c2len, i;
+	uint32_t xlen, ylen;
+
+	if (unlikely(inlen < 45)) { //head:10 hash:32 x:1 y:1 c2:1
+		SCTO_LOG_ERR("%s:inlen[%u], err!\n", __func__, inlen);
+		return -1;
+	}
+
+	if (unlikely(input[0] != 0x30)) { //check Tag
+		SCTO_LOG_ERR("%s:input[0] != 0x30, err!\n", __func__);
+		return -1;
+	}
+	if (input[1] & 0x80) {
+		headlen = 2 + (input[1] & 0x7f);
+		if (unlikely(headlen > 6)) {
+			SCTO_LOG_ERR("%s:headlen > 6, err!\n", __func__);
+			return -1;
+		}
+
+		length = 0;
+		for (i = 2; i < headlen; i++) {
+			length <<= 8;
+			length += input[i];
+		}
+	} else {
+		headlen = 2;
+		length = input[1];
+	}
+
+	if (unlikely(headlen + length != inlen)) {
+		SCTO_LOG_ERR("%s: %u (headlen + length != inlen %u ), err!\n",
+			     __func__, headlen + length, inlen);
+		return -1;
+	}
+
+	offset = headlen;
+	if (unlikely(input[offset] != 0x02)) {
+		SCTO_LOG_ERR("%s:(input[offset] != 0x02), err!\n", __func__);
+		return -1;
+	}
+
+	xlen = input[offset + 1];
+	xheadlen = 2;
+	if (xlen == 0x21) {
+		xheadlen = 3;
+		xlen = 0x20;
+	} else if (xlen > 0x21) {
+		SCTO_LOG_ERR("%s:(xlen > 0x21), err!\n", __func__);
+		return -1;
+	}
+
+	offset += xheadlen;
+	memcpy(x + 32 - xlen, input + offset, xlen);
+	offset += xlen;
+
+	if (unlikely(input[offset] != 0x02)) {
+		SCTO_LOG_ERR("%s:(input[offset] != 0x02), err!\n", __func__);
+		return -1;
+	}
+	ylen = input[offset + 1];
+	yheadlen = 2;
+	if (ylen == 0x21) {
+		yheadlen = 3;
+		ylen = 0x20;
+	}
+
+	if (unlikely(offset + yheadlen + ylen + 2 > inlen)) {
+		SCTO_LOG_ERR(
+			"%s:(offset + yheadlen + ylen + 2 > inlen), err!\n",
+			__func__);
+		return -1;
+	}
+
+	offset += yheadlen;
+	memcpy(y + 32 - ylen, input + offset, ylen);
+	offset += ylen;
+
+	if (unlikely((input[offset] != 0x04) || (input[offset + 1] != 0x20))) {
+		SCTO_LOG_ERR(
+			"%s:((input[offset] != 0x04) || (input[offset + 1] != 0x20)), err!\n",
+			__func__);
+		return -1;
+	}
+	hashheadlen = 2;
+	offset += hashheadlen;
+
+	if (unlikely(offset + 35 > inlen)) {
+		SCTO_LOG_ERR("%s:(offset + 35 > inlen), err!\n", __func__);
+		return -1;
+	}
+
+	memcpy(hash, input + offset, 32);
+	offset += 32;
+
+	if (unlikely(input[offset] != 0x04)) {
+		SCTO_LOG_ERR("%s:(input[offset] != 0x04), err!\n", __func__);
+		return -1;
+	}
+	if (input[offset + 1] & 0x80) {
+		c2headlen = 2 + (input[offset + 1] & 0x7f);
+		if (unlikely(c2headlen > 6)) {
+			SCTO_LOG_ERR("%s:(c2headlen > 6), err!\n", __func__);
+			return -1;
+		}
+
+		if (unlikely(offset + c2headlen > inlen)) {
+			SCTO_LOG_ERR("%s:(offset + c2headlen > inlen), err!\n",
+				     __func__);
+			return -1;
+		}
+
+		c2len = 0;
+		for (i = 2; i < c2headlen; i++) {
+			c2len <<= 8;
+			c2len += input[offset + i];
+		}
+	} else {
+		c2headlen = 2;
+		c2len = input[offset + 1];
+	}
+
+	offset += c2headlen;
+	if (unlikely(offset + c2len != inlen)) {
+		SCTO_LOG_ERR("%s:(offset + c2len != inlen), err!\n", __func__);
+		return -1;
+	}
+
+	output[0] = 0x04;
+	memcpy(output + 1, x, 32);
+	memcpy(output + 33, y, 32);
+	memcpy(output + 65, hash, 32);
+	memmove(output + 97, input + offset, c2len);
+	*outlen = c2len + 97;
+
+	return 0;
+}
