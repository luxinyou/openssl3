+#define get
+
+int phytium_scto_sm4_init(SM4_CTX *sm4ctx, uint32_t mode, uint32_t cryptomode,
+			  const uint8_t *key, const uint8_t *iv)
+{
+	phytium_sm4_context *psm4ctx;
+	void *dma_buf = NULL;
+
+	int desc_id = sm4ctx->desc_id;
+	if ((mode != SM4_MODE_ECB) && (mode != SM4_MODE_CBC) &&
+	    (mode != SM4_MODE_CTR))
+		return -1;
+	if (cryptomode > SM4_CRYPTO_DECRYPT || desc_id == NULL)
+		return -1;
+
+	if (key == NULL)
+		return -1;
+
+	if (desc_id > SCTO_DESC_NUM)
+		return -1;
+
+	if (desc_id <= 0) {
+		dma_buf = phytium_scto_mem_alloc(sm4ctx);
+		if (dma_buf == NULL)
+			return -1;
+	}
+
+	set_phytium_provctx_algo_with_descid(sm4ctx->provctx, desc_id, ALG_SM4);
+	psm4ctx = get_phytium_sm4_context(sm4ctx->provctx, desc_id);
+
+	if (iv)
+		memcpy(psm4ctx->oiv, iv, 16);
+
+	memcpy(psm4ctx->iv, psm4ctx->oiv, 16);
+	psm4ctx->total_len = 0;
+
+	psm4ctx->mode = mode;
+	psm4ctx->cryptomode = cryptomode;
+
+	memcpy(psm4ctx->scto_key, key, sizeof(psm4ctx->scto_key));
+	sm4_setkey_enc(&psm4ctx->sm4_ctx, key);
+	sm4_setkey_dec(&psm4ctx->sm4_ctx, key);
+
+	if (SKE_REVERSE(sm4ctx->provctx))
+		smx_reverse_word(psm4ctx->scto_key, psm4ctx->scto_key,
+				 SM4_KEY_WORD_LEN);
+
+	if (dma_buf)
+		psm4ctx->v_dma_buf = dma_buf;
+
+	psm4ctx->user_count = (volatile int *)((long)(sm4ctx->provctx->common_info_start) +
+					   SCTO_DESC_NUM * 8 + 128);
+
+	return 0;
+}
+
+int phytium_scto_sm4_update(SM4_CTX *sm4ctx, const uint8_t *in, uint32_t len,
+			    uint8_t *out)
+{
+	int desc_id = sm4ctx->desc_id;
+	int phytium_scto_fd = GET_SCTO_PROVIDER_FD(sm4ctx->provctx);
+	if (desc_id <= 0 || desc_id > SCTO_DESC_NUM || phytium_scto_fd < 0)
+		return -1;
+
+	if (len == 0)
+		return -1;
+
+	if (in == NULL || out == NULL)
+		return -1;
+
+	phytium_sm4_context *psm4ctx = get_phytium_sm4_context(sm4ctx->provctx, desc_id);
+
+	switch (psm4ctx->mode) {
+	case SM4_MODE_ECB:
+		if (len & 0xf)
+			return -1;
+		return phytium_scto_sm4_ecb(desc_id, in, len, out);
+	case SM4_MODE_CBC:
+		if (len & 0xf)
+			return -1;
+		return phytium_scto_sm4_cbc(desc_id, in, len, out);
+	case SM4_MODE_CTR:
+		return phytium_scto_sm4_ctr(desc_id, in, len, out);
+	default:
+		break;
+	}
+
+	return -1;
+}
