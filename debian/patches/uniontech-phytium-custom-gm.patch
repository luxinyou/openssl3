+	uint8_t src[512] = { 0 };
+	uint8_t *result;
+
+	if (a_prikey == NULL || b_pubkey == NULL || a_tmp_prikey == NULL ||
+	    a_tmp_pubkey == NULL || b_tmp_pubkey == NULL || ZA == NULL ||
+	    ZB == NULL || key_data == NULL) {
+		SCTO_LOG_ERR("Invalid null param\r\n");
+		return -1;
+	}
+
+	if (key_length == 0) {
+		SCTO_LOG_ERR("Invalid key len 0\r\n");
+		return -1;
+	}
+
+	result = malloc(key_length + 64);
+	if (result == NULL) {
+		SCTO_LOG_ERR("Alloc key space error\r\n");
+		return -1;
+	}
+
+	memset(result, 0, key_length + 64);
+	if (role)
+		src[0] = 1;
+	else
+		src[0] = 0;
+
+	memcpy(src + 1, a_prikey, 32);
+	memcpy(src + 1 + 96, a_tmp_prikey, 32);
+	memcpy(src + 1 + 128, a_tmp_pubkey, 64);
+	memcpy(src + 1 + 192, b_pubkey, 64);
+	memcpy(src + 1 + 256, b_tmp_pubkey, 64);
+	memcpy(src + 1 + 320, ZA, 32);
+	memcpy(src + 1 + 352, ZB, 32);
+
+	info.type = ALG_SM2_EXCHANGEKEY;
+	info.src = src;
+	info.src_len = 512;
+	info.dst = result;
+	info.dst_len = key_length + 64;
+
+	ret = ioctl(phytium_scto_fd, SCTO_SM2, (unsigned long)&info);
+	if (ret) {
+		SCTO_LOG_ERR("sm2 exchange key failed!\n");
+	} else {
+		memcpy(key_data, result, key_length);
+		if (S1)
+			memcpy(S1, result + key_length, 32);
+
+		if (SA)
+			memcpy(SA, result + key_length + 32, 32);
+	}
+
+	free(result);
+
+	/* copy from result */
+
+	return ret;
+}
