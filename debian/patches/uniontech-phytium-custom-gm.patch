+    { OSSL_FUNC_PROVIDER_GETTABLE_PARAMS, (void (*)(void))phytium_provider_gettable_params },
+    { OSSL_FUNC_PROVIDER_TEARDOWN, (void (*)(void))phytium_provider_teardown },
+    { OSSL_FUNC_PROVIDER_QUERY_OPERATION, (void (*)(void))phytium_provider_query },
+    OSSL_DISPATCH_END
+};
+
+/* Provider 初始化函数 */
+int ossl_scto_provider_init(const OSSL_CORE_HANDLE *handle,
+                        const OSSL_DISPATCH *in,
+                        const OSSL_DISPATCH **out,
+                        void **provctx) {
+# ifndef FIPS_MODULE
+    for (; in->function_id != 0; in++) {
+        switch (in->function_id) {
+            case OSSL_FUNC_CORE_NEW_ERROR:
+                c_new_error = OSSL_FUNC_core_new_error(in);
+                break;
+            case OSSL_FUNC_CORE_SET_ERROR_DEBUG:
+                c_set_error_debug = OSSL_FUNC_core_set_error_debug(in);
+                break;
+            case OSSL_FUNC_CORE_VSET_ERROR:
+                c_vset_error = OSSL_FUNC_core_vset_error(in);
+                break;
+        }
+    }
+# endif
+    *out = phytium_provider_dispatch_table;
+    phytium_provctx *ctx = OPENSSL_zalloc(sizeof(phytium_provctx));
+    ctx->scto_fd = -1;
+    ctx->regs_addr = NULL;
+    ctx->scto_hash_bigendian = 1;
+    ctx->scto_ske_bigendian = 1;
+    for (int i = 0; i < (sizeof(ctx->scto_desc_start) / sizeof(phytium_scto_context*)) ; i++ ) {
+        ctx->scto_desc_start[i] = NULL;
+    }
+
+    for (int i = 0; i < SCTO_DESC_NUM + 1; i++) {
+        ctx->dma_buf[i] = NULL;
+    }
+
+    memset(ctx->name, 0, sizeof(ctx->name));
+    strncpy(ctx->name, "Phytium SCTO Provider", sizeof(ctx->name) - 1);
+    memset(ctx->version, 0, sizeof(ctx->version));
+    strncpy(ctx->version, "1.8.3", sizeof(ctx->version) - 1);
+
+    // 构建信息（可以包含编译时信息）
+    memset(ctx->buildinfo, 0, sizeof(ctx->buildinfo));
+    snprintf(ctx->buildinfo, sizeof(ctx->buildinfo),
+             "Phytium SCTO Provider %s built on %s at %s",
+             ctx->version, __DATE__, __TIME__);
+
+    int ret = phytium_scto_lib_scto_init(ctx);
+    if (ret < 0) {
+        OPENSSL_free(ctx);
+        return 0;
+    }
+    *provctx = (void *)ctx;
+    return 1;
+}
+
