+static void *sm4_newctx(void *provctx)
+{
+	SM4_CTX *ctx = OPENSSL_zalloc(sizeof(SM4_CTX));
+	if (ctx == NULL) {
+		//ERR_raise(ERR_LIB_PROV, )
+		return NULL;
+	}
+	ctx->provctx = provctx;
+	return ctx;
+}
+
+static void sm4_freectx(void *vctx)
+{
+	SM4_CTX *ctx =(SM4_CTX*)vctx;
+	if (ctx != NULL) {
+		OPENSSL_free(ctx);
+	}
+}
