+static void *sm3_newctx(void *provctx)
+{
+	SM3_CTX *ctx = OPENSSL_zalloc(sizeof(SM3_CTX));
+	if (ctx == NULL) {
+		//ERR_raise(ERR_LIB_PROV, )
+		return NULL;
+	}
+	ctx->provctx = provctx;
+	return ctx;
+}
+
+static void sm3_freectx(void *vctx)
+{
+	SM3_CTX *ctx =(SM3_CTX*)vctx;
+	if (ctx != NULL) {
+		OPENSSL_free(ctx);
+	}
+}
+
+static int sm3_init(void *vctx)
+{
+	SM3_CTX *ctx =(SM3_CTX*)vctx;
+	int ret = phytium_scto_sm3_init(ctx);
+	if (ret < 0) return 0;
+	return 1;
+}
+
+static int sm3_update(void *vctx, const unsigned char *data, size_t datalen)
+{
+    SM3_CTX *ctx = (SM3_CTX *)vctx;
+    if (ctx == NULL || data == NULL) return 0;
+	int ret = phytium_scto_sm3_update(ctx, data, datalen);
+	if ( ret < 0) return 0;
+	return 1;
+}
+
+static int sm3_final(void *vctx, unsigned char *out, size_t *outl,  size_t outsize)
+{
+    SM3_CTX *ctx = (SM3_CTX *)vctx;
+    if (ctx == NULL || out == NULL || outl == NULL) return 0;
+	if (outsize < SM3_DIGEST_LENGTH) {
+        *outl = SM3_DIGEST_LENGTH;
+        return 0;
+    }
+
+    int ret = phytium_scto_sm3_final(ctx, out);
+	if ( ret < 0 ){
+		return 0;
+	}
+    *outl = SM3_DIGEST_LENGTH;
+    return 1;
+}
+
