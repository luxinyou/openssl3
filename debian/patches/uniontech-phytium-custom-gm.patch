+    switch (operation_id) {
+    case OSSL_OP_DIGEST:    // 摘要算法
+        return phytium_digests;
+    case OSSL_OP_CIPHER:    // 加密算法
+        return phytium_ciphers;
+    // case OSSL_OP_KEYMGMT:   // 密钥管理
+    //     return my_keymgmt;
+    // case OSSL_OP_SIGNATURE: // 签名算法
+    //     return phytium_signature;
+    default:
+        return NULL;
+    }
+}
