+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ */
+#include <sys/ioctl.h>
+#include <openssl/obj_mac.h>
+#include <openssl/evp.h>
+#include "scto.h"
+#include "smx_common.h"
+#include "sm4_phytium.h"
+#include "sm3_phytium.h"
+
+
+//#include "lib_phytium_log.h"
+
+// int phytium_scto_fd = -1;
+// static void *regs = NULL;
+// uint64_t *phytium_common_info_start = NULL;
+// phytium_scto_context *phytium_desc_start
+// 	[(SCTO_DESC_NUM + 1) * sizeof(phytium_scto_context) / 0x400000 + 1] = {
+// 		NULL
+// 	};
+static volatile mepool_t *
+	mepool[(SCTO_DESC_NUM + 1) * sizeof(mepool_t) / 0x400000 + 1] = { NULL };
+// static void *dma_buf[SCTO_DESC_NUM + 1] = { NULL };
+
+// uint32_t phytium_scto_ske_bigendian = 1;
+// uint32_t phytium_scto_hash_bigendian = 1;
+
+static int check_kernel_version(int fd, struct phy_crypto_kernel_info *info,
+				uint64_t lib_magic)
+{
+	int ret;
+
+	if (!info) {
+		return -1;
+	}
+
+	info->magic_number = lib_magic;
+	info->response = 0;
+	info->reserved = (SCTO_DESC_NUM << 8) + PER_DESC_DMA_BUF_SIZE;
+	ret = ioctl(fd, PHY_CRYPTO_DRIVER_INFO, info);
+	if (!ret) {
+		if (info->magic_number != lib_magic) {
+			fprintf(stderr,"%s is too old, please update it!",
+				     info->magic_number < lib_magic ? "Driver" :
+								      "Lib");
+			return -1;
+		}
+	}
+
+	if (info->response != 1) {
+		fprintf(stderr,"Mismatch lib and kernel module!\r\n");
+		return -1;
+	}
+
+	return ret;
+}
+
+void *phytium_scto_mem_alloc(_SM3_SM4_CTX *ctx)
+{
+	if (ctx->desc_id > SCTO_DESC_NUM) {
+		fprintf(stderr,"mem_alloc error! desc_id:0x%x\n", ctx->desc_id);
+		return NULL;
+	}
+	int id = 0, alloc_offset, retry_count = 0;
+
+RETRY:
+	alloc_offset =
+		__atomic_fetch_add(
+			&mepool[(SCTO_DESC_NUM + 1) * sizeof(mepool_t) /
+				0x400000][(0x400000 / sizeof(mepool_t)) - 1]
+				 .counter,
+			1, __ATOMIC_SEQ_CST) &
+		(SCTO_DESC_NUM - 1);
+
+	id = __atomic_exchange_n(
+		&mepool[alloc_offset / (0x400000 / sizeof(mepool_t))]
+		       [alloc_offset & ((0x400000 / sizeof(mepool_t)) - 1)]
+			       .counter,
+		0, __ATOMIC_SEQ_CST);
+
+	if (id == alloc_offset + 1) {
+		ctx->desc_id = id;
+		return ((phytium_provctx*)(ctx->provctx))->dma_buf[id];
+	} else {
+		if (unlikely(id))
+			fprintf(stderr,
+				"[%d][%d] = error!id:%d, offset:%d  \n",
+				alloc_offset / (0x400000 / sizeof(mepool_t)),
+				alloc_offset &
+					((0x400000 / sizeof(mepool_t)) - 1),
+				id, alloc_offset);
+		if (retry_count++ < SCTO_DESC_NUM)
+			goto RETRY;
+
+		return NULL;
+	}
+}
+
+
+void phytium_scto_mem_free(int desc_id)
+{
+	if (unlikely((desc_id > SCTO_DESC_NUM) || (desc_id <= 0))) {
+		fprintf(stderr,"mem_free error! desc_id:0x%x\n", desc_id);
+		return;
+	}
+
+	mepool[(desc_id - 1) / (0x400000 / sizeof(mepool_t))]
+	      [(desc_id - 1) & ((0x400000 / sizeof(mepool_t)) - 1)]
+		      .counter = (uint32_t)desc_id;
+}
+
+int phytium_scto_lib_scto_init(phytium_provctx *ctx)
+{
+	if (ctx == NULL) return -1;
+	uint64_t i;
+	uint64_t pagesize = getpagesize();
+	struct phy_crypto_kernel_info driver_info = { 0 };
+
+	ctx->scto_fd = open("/dev/dscto", O_RDWR | O_SYNC);
+	if (ctx->scto_fd < 0) {
+		perror("open error");
+		fprintf(stderr,"open scto failed!\n");
+		goto out;
+	}
+
+	if (check_kernel_version(ctx->scto_fd, &driver_info,
+				 PHY_CRYPTO_LIB_MAGIC)) {
+		fprintf(stderr,
+			"Check driver info error, please udpate kernel module!\r\n");
+		close(ctx->scto_fd);
+		return -1;
+	}
+
+	/* 记录大小端 */
+	ctx->scto_ske_bigendian = (driver_info.endian & 0x2) ? 1 : 0;
+	ctx->scto_hash_bigendian = (driver_info.endian & 0x1) ? 1 : 0;
+
+	ctx->regs_addr = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_SHARED,
+		    ctx->scto_fd, 0);
+	if (ctx->regs_addr == MAP_FAILED) {
+		fprintf(stderr,"mmap regs failed!\n");
+		goto out;
+	}
+
+	ctx->common_info_start = mmap(NULL, SCTO_DESC_NUM * 8 + 1024,
+					 PROT_READ, MAP_SHARED, ctx->scto_fd,
+					 pagesize);
+	if (ctx->common_info_start == MAP_FAILED) {
+		fprintf(stderr,"mmap common_info_start failed!\n");
+		goto out;
+	}
+
+	for (i = 0;
+	     i <
+	     (SCTO_DESC_NUM + 1) * sizeof(phytium_scto_context) / 0x400000 + 1;
+	     i++) {
+		ctx->scto_desc_start[i] =
+			mmap(NULL, 0x400000, PROT_READ | PROT_WRITE, MAP_SHARED,
+			      ctx->scto_fd, ((0x2ul) | (i << 2)) * pagesize);
+		if (ctx->scto_desc_start[i] == MAP_FAILED) {
+			fprintf(stderr,"mmap desc_start %lu failed!\n", i);
+			goto out;
+		}
+	}
+
+	for (i = 0; i < (SCTO_DESC_NUM + 1) * sizeof(mepool_t) / 0x400000 + 1;
+	     i++) {
+		mepool[i] = mmap(NULL, 0x400000, PROT_READ | PROT_WRITE,
+				 MAP_SHARED,  ctx->scto_fd,
+				 ((0x3ul) | (i << 2)) * pagesize);
+		if (mepool[i] == MAP_FAILED) {
+			fprintf(stderr,"mmap mepool %lu failed!\n", i);
+			goto out;
+		}
+	}
+
+	for (i = 1; i <= SCTO_DESC_NUM; i++) {
+		ctx->dma_buf[i] = mmap(NULL, PER_DESC_DMA_BUF_SIZE,
+				  PROT_READ | PROT_WRITE, MAP_SHARED,
+				  ctx->scto_fd,
+				  ctx->common_info_start[i]);
+		if (ctx->dma_buf[i] == MAP_FAILED) {
+			fprintf(stderr,"mmap dma_buf[%lu] failed!\n", i);
+			goto out;
+		}
+	}
+
+	return 0;
+
+out:
+	if (ctx->scto_fd < 0) {
+		return -1;
+	}
+
+	for (i = 1; i <= SCTO_DESC_NUM; i++) {
+		if (ctx->dma_buf[i]) {
+			munmap(ctx->dma_buf[i], PER_DESC_DMA_BUF_SIZE);
+		}
+	}
+
+	for (i = 0; i < (SCTO_DESC_NUM + 1) * sizeof(mepool_t) / 0x400000 + 1;
+	     i++) {
+		if (mepool[i])
+			munmap((void *)mepool[i], 0x400000);
+	}
+
+	for (i = 0;
+	     i <
+	     (SCTO_DESC_NUM + 1) * sizeof(phytium_scto_context) / 0x400000 + 1;
+	     i++) {
+		if (ctx->scto_desc_start[i])
+			munmap(ctx->scto_desc_start[i], 0x400000);
+	}
+
+	if (ctx->common_info_start)
+		munmap(ctx->common_info_start, SCTO_DESC_NUM * 8 + 1024);
+
+	if (ctx->regs_addr)
+		munmap(ctx->regs_addr, 0x10000);
+
+	close(ctx->scto_fd);
+
+	return -1;
+}
+
+void phytium_scto_lib_scto_exit(phytium_provctx *ctx)
+{
+	int i;
+	for (i = 1; i <= SCTO_DESC_NUM; i++) {
+		if (ctx->dma_buf[i]) {
+			munmap(ctx->dma_buf[i], PER_DESC_DMA_BUF_SIZE);
+		}
+	}
+
+	for (i = 0; i < (SCTO_DESC_NUM + 1) * sizeof(mepool_t) / 0x400000 + 1;
+	     i++) {
+		if (mepool[i])
+			munmap((void *)mepool[i], 0x400000);
+	}
+
+	for (i = 0;
+	     i <
+	     (SCTO_DESC_NUM + 1) * sizeof(phytium_scto_context) / 0x400000 + 1;
+	     i++) {
+		if (ctx->scto_desc_start[i])
+			munmap(ctx->scto_desc_start[i], 0x400000);
+	}
+
+	if (ctx->common_info_start)
+		munmap(ctx->common_info_start, SCTO_DESC_NUM * 8 + 1024);
+
+	if (ctx->regs_addr)
+		munmap(ctx->regs_addr, 0x10000);
+
+	if (ctx->scto_fd < 0) {
+		return;
+	}
+
+	close(ctx->scto_fd);
+}
