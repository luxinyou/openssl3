+static inline void smx_reverse_word(const void *in, void *out, uint32_t wordlen)
+{
+	uint32_t i;
+	const uint32_t *input = (const uint32_t*)in;
+	uint32_t *output = (uint32_t*)out;
+
+	for (i = 0; i < wordlen; i++)
+		output[i] = swap32(input[i]);
+}
+
+static inline void smx_dma_reverse_word(const void *in, void *out,
+					uint32_t wordlen)
+{
+	uint32_t i, j, tmp;
+	const uint32_t *input = (const uint32_t*)in;
+	uint32_t *output = (uint32_t*)out;
+
+	for (i = 0; i < wordlen; i += 4) {
+		for (j = 0; j < 2; j++) {
+			tmp = input[i + j];
+			output[i + j] = swap32(input[i + 0x3 - j]);
+			output[i + 0x3 - j] = swap32(tmp);
+		}
+	}
+}
