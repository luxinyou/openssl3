+    { OSSL_FUNC_DIGEST_UPDATE, (void (*)(void))sm3_update },
+    { OSSL_FUNC_DIGEST_FINAL, (void (*)(void))sm3_final },
+    { OSSL_FUNC_DIGEST_FREECTX, (void (*)(void))sm3_freectx },
+    { 0, NULL }
+};
