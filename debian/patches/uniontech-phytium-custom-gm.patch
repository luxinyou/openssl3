+
+static const int phytium_provider_get_params(void *provctx, OSSL_PARAM params[])
+{
+    phytium_provctx *ctx = (phytium_provctx*)provctx;
+    OSSL_PARAM *p;
+    if (ctx == NULL) return 0;
+
+    p = OSSL_PARAM_locate(params, OSSL_PROV_PARAM_NAME);
+    if (p != NULL && !OSSL_PARAM_set_utf8_ptr(p, ctx->name))
+        return 0;
+
+    p = OSSL_PARAM_locate(params, OSSL_PROV_PARAM_VERSION);
+    if (p != NULL && !OSSL_PARAM_set_utf8_ptr(p, ctx->version))
+        return 0;
+
+    p = OSSL_PARAM_locate(params, OSSL_PROV_PARAM_BUILDINFO);
+    if (p != NULL && !OSSL_PARAM_set_utf8_ptr(p, ctx->buildinfo))
+        return 0;
+
+    p = OSSL_PARAM_locate(params, OSSL_PROV_PARAM_STATUS);
+    if (p != NULL && !OSSL_PARAM_set_int(p, ossl_prov_is_running()))
+        return 0;
+
+    return 1;
+}
