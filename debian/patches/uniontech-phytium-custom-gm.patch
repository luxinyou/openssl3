+void scto_sm2signature_encode(uint8_t *input, uint8_t *sig, uint32_t *sig_len)
+{
+	uint32_t offset;
+	uint32_t rlen, slen;
+	uint8_t r[32], s[32];
+
+	for (offset = 0; offset < 31; offset++) {
+		if (input[offset])
+			break;
+	}
+
+	rlen = 32 - offset;
+	memcpy(r, input + 32 - rlen, rlen);
+
+	for (offset = 32; offset < 63; offset++) {
+		if (input[offset])
+			break;
+	}
+
+	slen = 64 - offset;
+	memcpy(s, input + 64 - slen, slen);
+
+	*sig_len = 6 + rlen + slen;
+	sig[0] = 0x30; //Tag 0, ASN1_SEQ(bit 0-4), Value = TLV + TLV + ...(bit5)
+	sig[1] = 4 + rlen + slen; //Len 0,
+	sig[2] = 0x02; //Tag 1, ASN1_INT(bit 0-4)
+	sig[3] = rlen; //Len 1,
+
+	offset = 4;
+	if (r[0] & 0x80) { //Highest bit, r is unsigned Integer
+		*sig_len += 1;
+		sig[1]++;
+		sig[3]++;
+		sig[4] = 0x00;
+		offset++;
+	}
+
+	memcpy(sig + offset, r, rlen);
+	offset += rlen;
+
+	sig[offset++] = 0x02; //Tag 2, ASN1_INT(bit 0-4)
+	sig[offset++] = slen; //Len 2,
+
+	if (s[0] & 0x80) { //Highest bit, s is unsigned Integer
+		*sig_len += 1;
+		sig[1]++;
+		sig[offset - 1]++;
+		sig[offset++] = 0x00;
+	}
+
+	memcpy(sig + offset, s, slen);
+}
+
+int scto_sm2signature_decode(uint8_t *sig, uint32_t sig_len, uint8_t *out)
+{
+	uint32_t offset = 4, len;
+	uint32_t rlen, slen;
+	uint8_t r[32] = { 0 }, s[32] = { 0 };
+
+	if (unlikely((sig[0] != 0x30) ||
+		     (sig[2] != 0x02))) { //check Tag 0 and Tag 1
+		SCTO_LOG_ERR(
+			"%s:((sig[0] != 0x30) || (sig[2] != 0x02)), err!\n",
+			__func__);
+		return -1;
+	}
+
+	len = sig[1] + 2;
+	if (unlikely(len != sig_len)) { //check Len 0
+		SCTO_LOG_ERR("%s:len != sig_len, err!\n", __func__);
+		return -1;
+	}
+
+	rlen = sig[3]; //check Len 1
+	if (rlen == 0x21) {
+		offset++;
+		rlen = 0x20;
+	} else if (rlen > 0x21) {
+		SCTO_LOG_ERR("%s:rlen > 0x21, err!\n", __func__);
+		return -1;
+	}
+
+	memcpy(r + 32 - rlen, sig + offset, rlen);
+	offset += rlen;
+
+	if (unlikely(sig[offset++] != 0x02)) { //check Tag 2
+		SCTO_LOG_ERR("%s:Tag 2 != 0x02, err!\n", __func__);
+		return -1;
+	}
+
+	slen = sig[offset]; //check Len 2
+	if (slen == 0x21) {
+		offset++;
+		slen = 0x20;
+	} else if (slen > 0x21) {
+		SCTO_LOG_ERR("%s:slen > 0x21, err!\n", __func__);
+		return -1;
+	}
+	offset++;
+
+	if (offset + slen == sig_len) //check Value Length
+		memcpy(s + 32 - slen, sig + offset, slen);
+	else {
+		SCTO_LOG_ERR("%s:offset + slen != sig_len, err!\n", __func__);
+		return -1;
+	}
+
+	memcpy(out, r, 32);
+	memcpy(out + 32, s, 32);
+
+	return 0;
+}
