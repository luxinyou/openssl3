+static phytium_sm4_context * get_phytium_sm4_context(phytium_provctx *provctx, int desc_id)
+{
+	phytium_scto_context *pscto_ctx = GET_PHYTIUM_SCTO_CTX_PTR(provctx, desc_id);
+	return &(pscto_ctx->psm4_ctx);
+}
+
+static int phytium_scto_sm4_ecb(SM4_CTX *sm4ctx, const uint8_t *in, uint32_t len,
+				uint8_t *out)
+{
+	uint32_t offset, buf_len;
+	int ret = -1;
+
+	int desc_id = sm4ctx->desc_id;
+	phytium_sm4_context *psm4ctx = get_phytium_sm4_context(sm4ctx, desc_id);
+
+#if SCTO_ENABLE_SMALL_PACKKET_CIPHER_OFFLOADS
+	if ((len < 256) || __atomic_load_n(psm4ctx->user_count, __ATOMIC_SEQ_CST)) {
+		if (psm4ctx->cryptomode == SM4_CRYPTO_DECRYPT)
+			sm4_crypt_ecb_dec(&psm4ctx->sm4_ctx, len, NULL, in, out);
+		else
+			sm4_crypt_ecb_enc(&psm4ctx->sm4_ctx, len, NULL, in, out);
+		return 0;
+	}
+#endif
+
+	offset = 0;
+	while (len) {
+		if (len <= PHYTIUM_SM4_DMA_SIZE) {
+			buf_len = len;
+		} else {
+			buf_len = PHYTIUM_SM4_DMA_SIZE;
+		}
+
+#if SCTO_ENABLE_SMALL_PACKKET_CIPHER_OFFLOADS
+		if (buf_len < 256) {
+			if (psm4ctx->cryptomode == SM4_CRYPTO_DECRYPT)
+				sm4_crypt_ecb_dec(&psm4ctx->sm4_ctx, buf_len, NULL,
+						  in + offset, out + offset);
+			else
+				sm4_crypt_ecb_enc(&psm4ctx->sm4_ctx, buf_len, NULL,
+						  in + offset, out + offset);
+
+			break;
+		}
+#endif
+
+		int phytium_scto_fd = GET_SCTO_PROVIDER_FD(sm4ctx->provctx);
+		if (SKE_REVERSE(sm4ctx->provctx)) {
+			smx_dma_reverse_word(in + offset, psm4ctx->v_dma_buf,
+					     buf_len >> 2);
+			ret = ioctl(phytium_scto_fd, SCTO_SM4,
+				    ((long)desc_id << 32) | buf_len);
+			if (ret)
+				return -1;
+			smx_dma_reverse_word(psm4ctx->v_dma_buf, out + offset,
+					     buf_len >> 2);
+		} else {
+			memcpy(psm4ctx->v_dma_buf, in + offset, buf_len);
+
+			ret = ioctl(phytium_scto_fd, SCTO_SM4,
+				    ((long)desc_id << 32) | buf_len);
+			if (ret)
+				return -1;
+			memcpy(out + offset, psm4ctx->v_dma_buf, buf_len);
+		}
+
+		len -= buf_len;
+		offset += buf_len;
+	}
+
+	return 0;
+}
+
+static int phytium_scto_sm4_cbc(SM4_CTX *sm4ctx, const uint8_t *in, uint32_t len,
+				uint8_t *out)
+{
+	uint32_t offset, buf_len;
+	int ret = -1;
+
+	int desc_id = sm4ctx->desc_id;
+	phytium_sm4_context *psm4ctx = get_phytium_sm4_context(sm4ctx, desc_id);
+
+#if SCTO_ENABLE_SMALL_PACKKET_CIPHER_OFFLOADS
+	if ((len < 256) || __atomic_load_n(psm4ctx->user_count, __ATOMIC_SEQ_CST)) {
+		if (psm4ctx->cryptomode == SM4_CRYPTO_DECRYPT)
+			sm4_crypt_cbc_dec(&psm4ctx->sm4_ctx, len, psm4ctx->iv, in, out);
+		else
+			sm4_crypt_cbc_enc(&psm4ctx->sm4_ctx, len, psm4ctx->iv, in, out);
+		return 0;
+	}
+#endif
+
+	offset = 0;
+	while (len) {
+		if (len <= PHYTIUM_SM4_DMA_SIZE) {
+			buf_len = len;
+		} else {
+			buf_len = PHYTIUM_SM4_DMA_SIZE;
+		}
+
+#if SCTO_ENABLE_SMALL_PACKKET_CIPHER_OFFLOADS
+		if (buf_len < 256) {
+			if (psm4ctx->cryptomode == SM4_CRYPTO_DECRYPT)
+				sm4_crypt_cbc_dec(&psm4ctx->sm4_ctx, buf_len,
+						  psm4ctx->iv, in + offset,
+						  out + offset);
+			else
+				sm4_crypt_cbc_enc(&psm4ctx->sm4_ctx, buf_len,
+						  psm4ctx->iv, in + offset,
+						  out + offset);
+
+			break;
+		}
+#endif
+		int phytium_scto_fd = GET_SCTO_PROVIDER_FD(sm4ctx->provctx);
+		if (SKE_REVERSE(sm4ctx->provctx)) {
+			smx_dma_reverse_word(in + offset, psm4ctx->v_dma_buf,
+					     buf_len >> 2);
+			ret = ioctl(phytium_scto_fd, SCTO_SM4,
+				    ((long)desc_id << 32) | buf_len);
+			if (ret)
+				return -1;
+
+			if (psm4ctx->cryptomode)
+				memcpy(psm4ctx->iv, in + offset + buf_len - 16, 16);
+			smx_dma_reverse_word(psm4ctx->v_dma_buf, out + offset,
+					     buf_len >> 2);
+
+		} else {
+			memcpy(psm4ctx->v_dma_buf, in + offset, buf_len);
+
+			ret = ioctl(phytium_scto_fd, SCTO_SM4,
+				    ((long)desc_id << 32) | buf_len);
+			if (ret)
+				return -1;
+
+			if (psm4ctx->cryptomode)
+				memcpy(psm4ctx->iv, in + offset + buf_len - 16, 16);
+
+			memcpy(out + offset, psm4ctx->v_dma_buf, buf_len);
+		}
+
+		len -= buf_len;
+		offset += buf_len;
+
+		if (!psm4ctx->cryptomode)
+			memcpy(psm4ctx->iv, out + offset - 16, 16);
+	}
+
+	return 0;
+}
+
+static int _sm4_ctr_small_packet(SM4_CTX *sm4ctx, const uint8_t *in, uint32_t len,
+				 uint8_t *out)
+{
+	uint32_t offset = 0, buf_len, ctr_len, i, left, fill;
+	int ret = -1;
+	uint8_t tempiv[16], temp[16];
+	int desc_id = sm4ctx->desc_id;
+	phytium_sm4_context *psm4ctx = get_phytium_sm4_context(sm4ctx, desc_id);
+
+	left = psm4ctx->total_len & 0xf;
+	fill = 16 - left;
+	psm4ctx->total_len += len;
+	if (left) {
+		if (len >= fill) {
+			memcpy(temp + left, in + offset, fill);
+			sm4_crypt_ctr(&psm4ctx->sm4_ctx, 16, psm4ctx->iv, temp, temp);
+			memcpy(out + offset, temp + left, fill);
+			len -= fill;
+			offset += fill;
+		} else {
+			// no change iv
+			memcpy(tempiv, psm4ctx->iv, 16);
+			memcpy(temp + left, in + offset, len);
+			sm4_crypt_ctr(&psm4ctx->sm4_ctx, 16, tempiv, temp, temp);
+			memcpy(out + offset, temp + left, len);
+			return 0;
+		}
+	}
+
+	left = len & 0xf;
+	len -= left;
+	while (len) {
+		if (len <= PHYTIUM_SM4_DMA_SIZE) {
+			buf_len = len;
+		} else {
+			buf_len = PHYTIUM_SM4_DMA_SIZE;
+		}
+
+		sm4_crypt_ctr(&psm4ctx->sm4_ctx, buf_len, psm4ctx->iv, in + offset,
+			      out + offset);
+		len -= buf_len;
+		offset += buf_len;
+	}
+
+	if (left) {
+		memcpy(tempiv, psm4ctx->iv, 16);
+		memcpy(temp, in + offset, left);
+		sm4_crypt_ctr(&psm4ctx->sm4_ctx, 16, tempiv, temp, temp);
+		memcpy(out + offset, temp, left);
+	}
+
+	return 0;
+}
+
+static int phytium_scto_sm4_ctr(SM4_CTX *sm4ctx, const uint8_t *in, uint32_t len,
+				uint8_t *out)
+{
+	uint32_t offset = 0, buf_len, ctr_len, i, left, fill;
+	uint8_t tmp, *iv;
+	uint32_t num;
+	int over = 0;
+	int ret = -1;
+	uint8_t temp[16], tempiv[16];
+
+	int desc_id = sm4ctx->desc_id;
+	phytium_sm4_context *psm4ctx = get_phytium_sm4_context(sm4ctx, desc_id);
+
+#if SCTO_ENABLE_SMALL_PACKKET_CIPHER_OFFLOADS
+	if ((len < 256) || __atomic_load_n(psm4ctx->user_count, __ATOMIC_SEQ_CST)) {
+		return _sm4_ctr_small_packet(desc_id, in, len, out);
+	}
+#endif
+
+	left = psm4ctx->total_len & 0xf;
+	fill = 16 - left;
+	psm4ctx->total_len += len;
+	if (left) {
+		if (len >= fill) {
+			memcpy(temp + left, in + offset, fill);
+			sm4_crypt_ctr(&psm4ctx->sm4_ctx, 16, psm4ctx->iv, temp, temp);
+			memcpy(out + offset, temp + left, fill);
+			len -= fill;
+			offset += fill;
+		} else {
+			// no change iv
+			memcpy(tempiv, psm4ctx->iv, 16);
+			memcpy(temp + left, in + offset, len);
+			sm4_crypt_ctr(&psm4ctx->sm4_ctx, 16, tempiv, temp, temp);
+			memcpy(out + offset, temp + left, len);
+			return 0;
+		}
+	}
+
+	num = len & 0xf;
+	len -= num;
+
+	int phytium_scto_fd = GET_SCTO_PROVIDER_FD(sm4ctx->provctx);
+	while (len) {
+		if (len <= PHYTIUM_SM4_DMA_SIZE) {
+			buf_len = len;
+		} else {
+			buf_len = PHYTIUM_SM4_DMA_SIZE;
+		}
+
+
+		if (SKE_REVERSE(sm4ctx->provctx)) {
+			smx_dma_reverse_word(in + offset, psm4ctx->v_dma_buf,
+					     buf_len >> 2);
+		} else {
+			memcpy(psm4ctx->v_dma_buf, in + offset, buf_len);
+		}
+
+		ret = ioctl(phytium_scto_fd, SCTO_SM4,
+			    ((long)desc_id << 32) | buf_len);
+		if (ret)
+			return -1;
+
+		iv = (uint8_t *)psm4ctx->iv;
+		ctr_len = buf_len >> 4;
+		for (i = 15; i >= 0; i--) {
+			tmp = iv[i];
+			if (ctr_len) {
+				iv[i] += ctr_len;
+				ctr_len >>= 8;
+			}
+
+			if (tmp > iv[i]) {
+				ctr_len++;
+				if (i == 12)
+					over = 1;
+			} else if (!ctr_len) {
+				break;
+			}
+		}
+
+		if (SKE_REVERSE(sm4ctx->provctx)) {
+			if (over) {
+				over = 0;
+				ctr_len = swap32(*(uint32_t *)(&iv[12]));
+				ctr_len <<= 4;
+				*(uint32_t *)(&iv[12]) = 0;
+				smx_dma_reverse_word(psm4ctx->v_dma_buf,
+						     out + offset,
+						     (buf_len - ctr_len) >> 2);
+				if (ctr_len) {
+					smx_dma_reverse_word(
+						in + offset +
+							(buf_len - ctr_len),
+						psm4ctx->v_dma_buf, ctr_len >> 2);
+					ret = ioctl(phytium_scto_fd, SCTO_SM4,
+						    ((long)desc_id << 32) |
+							    ctr_len);
+					if (ret)
+						return -1;
+					smx_dma_reverse_word(
+						psm4ctx->v_dma_buf,
+						out + offset +
+							(buf_len - ctr_len),
+						ctr_len >> 2);
+					ctr_len >>= 4;
+					*(uint32_t *)(&iv[12]) =
+						swap32(ctr_len);
+				}
+			} else {
+				smx_dma_reverse_word(psm4ctx->v_dma_buf,
+						     out + offset,
+						     buf_len >> 2);
+			}
+		} else {
+			memcpy(out + offset, psm4ctx->v_dma_buf, buf_len);
+		}
+
+		len -= buf_len;
+		offset += buf_len;
+	}
+
+	if (num) {
+		memcpy(tempiv, psm4ctx->iv, 16);
+		memcpy(temp, in + offset, num);
+		sm4_crypt_ctr(&psm4ctx->sm4_ctx, 16, tempiv, temp, temp);
+		memcpy(out + offset, temp, num);
+	}
+
+	return 0;
+}
